rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules).
//
// BEFORE DEPLOYING: replace REPLACE_WITH_COACH_UID with your coach account's
// uid (Firebase Console → Authentication → Users). Until then nobody can read
// client records — that fails closed, it doesn't open anything up.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the coach account may read or change client records. The old rule
    // (`request.auth != null`) let ANY signed-in user read every intake, and
    // with email/password sign-up enabled anyone can make an account using
    // the public API key in firebase.js.
    function isCoach() {
      return request.auth != null && request.auth.uid in ['REPLACE_WITH_COACH_UID'];
    }

    // An anonymous intake submission: a new document only (a write to an
    // existing id is an update, which only the coach may do), with exactly
    // the schema client.js writes, and only with explicit health-data consent
    // (GDPR Art. 9).
    function isValidIntakeCreate(clientId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'naam', 'createdAt', 'intake', 'instellingen', 'calculations', 'consents'])
        && d.id == clientId
        && d.intake is map
        && d.consents.healthData == true;
    }

    match /clients/{clientId} {
      allow create: if isCoach() || isValidIntakeCreate(clientId);
      allow read, update, delete: if isCoach();
    }
  }
}
